    "# Cell 6 — Genetic Algorithm (Stable Top-K + Elitism + Uniform Crossover)\n",
    sinkron dengan training\n"

    "TOTAL_MARRIAGES = 0\n",
    "\n",
    # ── GA Hyperparameters
    "MUTATION_RATE_NEW  = 0.12   # was 0.40\n",
    "MUTATION_STR_MIN   = 0.05   # normal low\n",
    "MUTATION_STR_MAX   = 0.5    # normal high\n",
    "CHAOS_PROB         = 0.10   # was 0.30\n",
    "CHAOS_STR_MIN      = 0.5\n",
    "CHAOS_STR_MAX      = 2.0\n",
    "PARENT_POOL_SIZE   = 10     # Top-K\n",
    "ELITE_COUNT        = 1      # elit langsung copy tanpa mutasi\n",
    "\n",
    "# Buffer logging untuk grafik Cell 9\n",
    "_last_mutation_log = []\n",
    "_last_alive_curve  = []\n",
    "\n",
    "def uniform_crossover(w1, w2):\n",
    "    \"\"\"Tiap weight dipilih random dari salah satu parent.\"\"\"\n",
    "    mask = np.random.rand(len(w1)) < 0.5\n",
    "    return np.where(mask, w1, w2)\n",
    "\n",
    "def mutate_stable(w):\n",
    "    \"\"\"Mutasi stabil: rate rendah, chaos max 10%.\"\"\"\n",
    "    w    = w.copy()\n",
    "    mask = np.random.rand(len(w)) < MUTATION_RATE_NEW\n",
    "    n    = mask.sum()\n",
    "    if n == 0:\n",
    "        return w\n",
    "    chaos_mask = np.random.rand(n) < CHAOS_PROB\n",
    "    strengths  = np.where(\n",
    "        chaos_mask,\n",
    "        np.random.uniform(CHAOS_STR_MIN, CHAOS_STR_MAX, n),\n",
    "        np.random.uniform(MUTATION_STR_MIN, MUTATION_STR_MAX, n)\n",
    "    )\n",
    "    w[mask] += np.random.randn(n) * strengths\n",
    "    return w\n",
    "\n",
    "def evolve(cars, generation, current_pop):\n",
    "    global TOTAL_MARRIAGES, _last_mutation_log\n",
    "\n",
    "    cars.sort(key=lambda c: c.fitness, reverse=True)\n",
    "\n",
    "    # Top-K parent pool
    "    k           = min(PARENT_POOL_SIZE, len(cars))\n",
    "    parent_pool = [c.brain.get_weights().copy() for c in cars[:k]]\n",
    "\n",
    "    next_pop         = min(current_pop * 2, POP_MAX)\n",
    "    new_w            = []\n",
    "    marriages        = 0\n",
    "    _mutation_deltas = []  # delta asli dari child yang diproduksi\n",
    "\n",
    "    # ── Elitism: salin elit langsung, tanpa mutasi ────────────\n",
    "    for i in range(min(ELITE_COUNT, len(parent_pool))):\n",
    "        new_w.append(parent_pool[i].copy())\n",
    "\n",
    "    # ── Isi sisa populasi via crossover + mutasi ──────────────\n",
    "    while len(new_w) < next_pop:\n",
    "        pA = random.choice(parent_pool).copy()  # fix 1: copy, bukan referensi\n",
    "        pB = random.choice(parent_pool).copy()\n",
    "        if len(parent_pool) > 1:\n",
    "            attempts = 0\n",
    "            while np.array_equal(pA, pB) and attempts < 10:\n",
    "                pB = random.choice(parent_pool).copy()\n",
    "                attempts += 1\n",
    "        before = uniform_crossover(pA, pB)\n",
    "        child  = mutate_stable(before)\n",
    "        _mutation_deltas.extend((child - before).tolist())  # fix 2: delta asli\n",
    "        new_w.append(child)\n",
    "        marriages += 1\n",
    "\n",
    "    # ── Catat mutation log untuk histogram ───────────────────\n",
    "    _last_mutation_log.clear()\n",
    "    _last_mutation_log.extend(_mutation_deltas)\n",
    "\n",
    "    TOTAL_MARRIAGES += marriages\n",
    "    return [NeuralNet(w) for w in new_w], marriages, next_pop\n",
    "\n",
    "print('GA — Stable Top-K + Elitism + Uniform Crossover ready!')"
   ],
   "execution_count": null,
   "outputs": []
