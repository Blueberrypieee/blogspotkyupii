    "# Cell 8 — Training Loop\n",
    "print('Mulai training — Stable GA v4.1 (Top-K + Elitism + Uniform Crossover)\\n')\n",
    "\n",
    "TOTAL_MARRIAGES = 0\n",
    "\n",
    "current_pop   = POP_START\n",
    "brains        = [NeuralNet() for _ in range(current_pop)]\n",
    "cars          = [Car(b) for b in brains]\n",
    "history       = []   # (gen, best, mean, std, best_dist, mut_log, alive_curve, actual_pop)\n",
    "gif_frames    = {}\n",
    "marriages_log = {}\n",
    "\n",
    "for gen in range(1, N_GENERATIONS + 1):\n",
    "    for car in cars:\n",
    "        car.reset()\n",
    "\n",
    "    recording          = gen in RENDER_GENS\n",
    "    frames_this_gen    = []\n",
    "    marriages_this_gen = marriages_log.get(gen - 1, 0)\n",
    "    alive_curve        = []   # jumlah mobil hidup per frame\n",
    "\n",
    "    for f in range(MAX_FRAMES):\n",
    "        for car in cars:\n",
    "            car.update()\n",
    "        alive_curve.append(sum(c.alive for c in cars))\n",
    "        if recording and f % SAMPLE_EVERY == 0:\n",
    "            frames_this_gen.append(\n",
    "                render_frame(cars, gen, marriages_this_gen, current_pop)\n",
    "            )\n",
    "        if all(not c.alive for c in cars):\n",
    "            break\n",
    "\n",
    "    # ── Kumpulkan stats generasi ini ─────────────────────────\n",
    "    all_fits  = [c.fitness for c in cars]\n",
    "    best_gen  = max(all_fits)\n",
    "    mean_fit  = float(np.mean(all_fits))\n",
    "    std_fit   = float(np.std(all_fits))\n",
    "    best_car  = max(cars, key=lambda c: c.fitness)\n",
    "    best_dist = float(math.sqrt((best_car.x - START_X)**2 + (best_car.y - START_Y)**2))\n",
    "\n",
    "    history.append((gen, best_gen, mean_fit, std_fit, best_dist,\n",
    "                    _last_mutation_log.copy(), alive_curve, current_pop))  # [7]=actual pop\n",
    "\n",
    "    if recording:\n",
    "        gif_frames[gen] = frames_this_gen\n",
    "\n",
    "    new_brains, marriages, next_pop = evolve(cars, gen, current_pop)\n",
    "    marriages_log[gen] = marriages\n",
    "    current_pop        = next_pop\n",
    "    cars               = [Car(b) for b in new_brains]\n",
    "\n",
    "    print(f'Gen {gen:3d} | Pop: {current_pop:3d} | Best: {int(best_gen):4d} | Mean: {mean_fit:6.1f} | Std: {std_fit:5.1f} | Marriages: {marriages}x')\n",
    "\n",
    "print(f'\\nTraining selesai! Total perkawinan: {TOTAL_MARRIAGES}x')"
   ],
